# Keep API credentials on the Python server.
LLM_API_KEY=
# Use the exact regional base URL and model ID shown by your sponsor dashboard.
LLM_BASE_URL=https://api.tokenfactory.nebius.com/v1/
LLM_MODEL=nvidia/Nemotron-3.5-Super-VL
# Verified Nemotron setting: reserve the output budget for the final answer/report.
# Change these provider-specific options if choosing a different model.
LLM_EXTRA_BODY={"chat_template_kwargs":{"enable_thinking":false}}
TAVILY_API_KEY=
CORS_ORIGINS=http://localhost:5173
# Leave both blank for local development. Production Basic login protects UI/API/docs.
JURY_USERNAME=
JURY_PASSWORD=
# Enable these on the deployed service after configuring credentials.
REQUIRE_JURY_AUTH=false
REQUIRE_LIVE_AI=false
# Docker sets APP_ROOT=/app. Set it to the checkout path when running an installed wheel.
# APP_ROOT=/absolute/path/to/Supplier-Risk-Intelligence

