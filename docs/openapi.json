{
  "openapi": "3.1.0",
  "info": {
    "title": "Supplier Risk Intelligence",
    "version": "0.1.0"
  },
  "paths": {
    "/api/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_api_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
